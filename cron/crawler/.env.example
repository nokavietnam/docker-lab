# Database Configuration (Kết nối vào Docker Postgres có sẵn trong lab-network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=lab_db
POSTGRES_PORT=5432

# URL khi crawler chạy trong Docker network (lab-network):
DATABASE_URL=postgres://postgres:supersecretpassword@postgres:5432/lab_db?sslmode=disable
# Nếu chạy local ngoài Docker thì dùng:
# DATABASE_URL=postgres://postgres:supersecretpassword@localhost:5432/lab_db?sslmode=disable

# Crawler Target Configuration
BASE_URL=https://muaban.net
CATEGORY_PATH=bat-dong-san/ban-nha
START_PAGE=1
MAX_PAGES=500

# Concurrency & Anti-Bot Tuning (Tối ưu CPU, RAM và tránh chặn IP)
CONCURRENCY=2
MIN_DELAY_MS=1200
MAX_DELAY_MS=2500
BATCH_SIZE=20

# Daily Random Scheduling (3h - 5h sáng ngẫu nhiên)
RUN_MODE=cron
CRON_START_HOUR=3
CRON_END_HOUR=5

# Incremental Deduplication (Chống trùng lặp & Dừng sớm thông minh)
INCREMENTAL_MODE=true
MAX_EXISTING_THRESHOLD=20

# Optional Proxy Pool
PROXIES=
